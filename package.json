{
  "name": "code-agent",
  "displayName": "Code Agent",
  "description": "基于大语言模型的智能编程 Agent：代码生成、文件编辑、终端执行、多轮任务自主闭环",
  "version": "1.0.0",
  "publisher": "wangh",
  "author": {
    "name": "wangh"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "copilot",
    "llm",
    "deepseek",
    "chat"
  ],
  "activationEvents": [
    "onView:codeAgent.chatView",
    "onCommand:codeAgent.openPanel",
    "onCommand:codeAgent.openSettings",
    "onCommand:codeAgent.newSession",
    "onCommand:codeAgent.addSelection"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeAgent",
          "title": "Code Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeAgent": [
        {
          "id": "codeAgent.chatView",
          "type": "webview",
          "name": "对话"
        }
      ]
    },
    "commands": [
      {
        "command": "codeAgent.openPanel",
        "title": "Code Agent: 打开对话面板",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codeAgent.openSettings",
        "title": "Code Agent: 打开设置",
        "icon": "$(gear)"
      },
      {
        "command": "codeAgent.newSession",
        "title": "Code Agent: 新建对话",
        "icon": "$(add)"
      },
      {
        "command": "codeAgent.addSelection",
        "title": "Add to Code Agent"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeAgent.openPanel",
          "when": "view == codeAgent.chatView",
          "group": "navigation"
        },
        {
          "command": "codeAgent.newSession",
          "when": "view == codeAgent.chatView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "codeAgent.addSelection",
          "when": "editorHasSelection",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Code Agent",
      "properties": {
        "codeAgent.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "模型接口 Base URL（OpenAI 兼容协议）"
        },
        "codeAgent.models": {
          "type": "array",
          "default": [
            {
              "id": "deepseek-v4-flash",
              "name": "DeepSeek V4 Flash",
              "contextWindow": 131072,
              "maxOutputTokens": 8192,
              "pricing": "按量计费"
            },
            {
              "id": "deepseek-v4-pro",
              "name": "DeepSeek V4 Pro",
              "contextWindow": 262144,
              "maxOutputTokens": 32768,
              "pricing": "按量计费"
            }
          ],
          "description": "已配置的模型列表（OpenAI 兼容协议，可自定义新增）"
        },
        "codeAgent.defaultModel": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "description": "默认使用的模型"
        },
        "codeAgent.defaultMode": {
          "type": "string",
          "enum": [
            "chat",
            "agent"
          ],
          "default": "agent",
          "description": "双层权限体系第一层：默认运行模式——对话模式（只读文件问答，写入/终端全局禁用）/ 智能体模式（完整 Agent 能力，读写工作区文件、执行终端命令）"
        },
        "codeAgent.requestTimeout": {
          "type": "number",
          "default": 120000,
          "description": "API 请求超时时间（毫秒）"
        },
        "codeAgent.proxy": {
          "type": "string",
          "default": "",
          "description": "网络代理地址（如 http://127.0.0.1:7890，留空不使用）"
        },
        "codeAgent.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "全局默认采样温度"
        },
        "codeAgent.topP": {
          "type": "number",
          "default": 0.95,
          "minimum": 0,
          "maximum": 1,
          "description": "全局默认核采样参数 top_p"
        },
        "codeAgent.maxTokens": {
          "type": "number",
          "default": 8192,
          "description": "全局默认单次最大输出 Token 数"
        },
        "codeAgent.frequencyPenalty": {
          "type": "number",
          "default": 0,
          "minimum": -2,
          "maximum": 2,
          "description": "全局默认频率惩罚"
        },
        "codeAgent.permissionMode": {
          "type": "string",
          "enum": [
            "ask",
            "auto"
          ],
          "default": "ask",
          "description": "双层权限体系第二层：权限管理（仅智能体模式下生效，对话模式下不生效）——询问模式（修改工作区内文件前提示确认，推荐）/ 全自动模式（修改工作区内文件自动放行）；仅作用于智能体模式下工作区内文件的写入，工作区外文件任何模式下只读"
        },
        "codeAgent.terminalAutoApprove": {
          "type": "boolean",
          "default": false,
          "description": "工作区内终端命令免确认（高危命令始终需要确认；终端命令执行不受询问/全自动模式影响）"
        },
        "codeAgent.highRiskCommands": {
          "type": "boolean",
          "default": true,
          "description": "高危命令拦截开关（破坏性命令强制二次确认）"
        },
        "codeAgent.maxToolIterations": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 1000,
          "description": "单轮任务中 Agent 可自主调度工具的最大次数（触发上限时任务中断并提示）"
        },
        "codeAgent.autoCompressThreshold": {
          "type": "number",
          "default": 0.75,
          "minimum": 0.3,
          "maximum": 0.95,
          "description": "自动上下文压缩阈值（上下文占用达到模型总窗口该比例时触发）"
        },
        "codeAgent.historyPath": {
          "type": "string",
          "default": "",
          "description": "历史对话存储路径（留空默认使用当前工作区 .code-agent/history 目录，支持自定义绝对路径）"
        },
        "codeAgent.folderIncludePatterns": {
          "type": "array",
          "default": [
            "**/*.{ts,tsx,js,jsx,json,md,py,java,go,rs,c,cpp,h,hpp,cs,html,css,scss,vue,yml,yaml,sh,bat,ps1,sql}"
          ],
          "description": "@文件夹引用时的文件类型过滤规则"
        },
        "codeAgent.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "日志级别"
        },
        "codeAgent.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "调试模式（输出更详细的诊断信息）"
        },
        "codeAgent.autoUpdateCheck": {
          "type": "boolean",
          "default": true,
          "description": "启动时自动检测插件更新"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && node scripts/prepackage.js && vsce package -o releases/ --no-rewrite-relative-links",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.21.5",
    "https-proxy-agent": "^7.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "@vscode/vsce": "^2.26.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
